diff --git a/src/DuelChallengePolicy.cs b/src/DuelChallengePolicy.cs
new file mode 100644
index 0000000..f7ddd65
--- /dev/null
+++ b/src/DuelChallengePolicy.cs
@@ -0,0 +1,166 @@
+using System;
+
+namespace ErenshorDuel
+{
+    internal enum DuelSocialDecision
+    {
+        Accept,
+        Decline,
+        DeclineLowHealth,
+        DeclineRecentDuel,
+        DeclineLevelMismatch
+    }
+
+    internal struct DuelWillingnessInput
+    {
+        internal bool IsPartySim;
+        internal bool Rival;
+        internal bool HasHealth;
+        internal int CurrentHealth;
+        internal int MaximumHealth;
+        internal bool HasLevel;
+        internal int PlayerLevel;
+        internal int SimLevel;
+        internal bool RecentDuel;
+        internal string StableKey;
+    }
+
+    internal static class DuelChallengePolicy
+    {
+        internal static DuelSocialDecision Evaluate(DuelWillingnessInput input)
+        {
+            // Preserve established 0.3 behavior for party Sims once mechanical safety is proven.
+            if (input.IsPartySim) return DuelSocialDecision.Accept;
+            if (input.RecentDuel) return DuelSocialDecision.DeclineRecentDuel;
+
+            int score = 5;
+            bool healthConcern = false;
+            bool levelMismatch = false;
+
+            if (input.HasHealth && input.MaximumHealth > 0)
+            {
+                int healthPercent = Math.Max(0, Math.Min(100,
+                    (int)Math.Round(input.CurrentHealth * 100.0 / input.MaximumHealth)));
+                if (healthPercent < 35) return DuelSocialDecision.DeclineLowHealth;
+                if (healthPercent < 60)
+                {
+                    score -= 2;
+                    healthConcern = true;
+                }
+                else if (healthPercent >= 85) score += 1;
+            }
+
+            if (input.HasLevel && input.PlayerLevel > 0 && input.SimLevel > 0)
+            {
+                int lower = Math.Min(input.PlayerLevel, input.SimLevel);
+                int delta = Math.Abs(input.PlayerLevel - input.SimLevel);
+                int seriousMismatch = Math.Max(8, lower / 2);
+                if (delta >= seriousMismatch)
+                {
+                    score -= 3;
+                    levelMismatch = true;
+                }
+                else if (delta <= 3) score += 1;
+            }
+
+            // Rival is a bounded modifier. It cannot bypass mechanical eligibility, cooldown,
+            // or the hard low-health reluctance above.
+            if (input.Rival) score += 2;
+
+            // Stable bounded variation prevents every similarly-ready non-party Sim from making
+            // the same choice. Do not use string.GetHashCode: process stability is not guaranteed.
+            score += StableOffset(input.StableKey);
+
+            if (score >= 5) return DuelSocialDecision.Accept;
+            if (healthConcern) return DuelSocialDecision.DeclineLowHealth;
+            if (levelMismatch) return DuelSocialDecision.DeclineLevelMismatch;
+            return DuelSocialDecision.Decline;
+        }
+
+        internal static string Token(DuelSocialDecision decision)
+        {
+            switch (decision)
+            {
+                case DuelSocialDecision.Accept: return "accept";
+                case DuelSocialDecision.DeclineLowHealth: return "decline_low_health";
+                case DuelSocialDecision.DeclineRecentDuel: return "decline_recent_duel";
+                case DuelSocialDecision.DeclineLevelMismatch: return "decline_level_mismatch";
+                default: return "decline";
+            }
+        }
+
+        internal static string RunSelfTests()
+        {
+            if (Evaluate(new DuelWillingnessInput { IsPartySim = true, RecentDuel = true }) != DuelSocialDecision.Accept)
+                return "FAIL party Sim compatibility";
+
+            DuelWillingnessInput low = new DuelWillingnessInput
+            {
+                HasHealth = true,
+                CurrentHealth = 20,
+                MaximumHealth = 100,
+                StableKey = "low"
+            };
+            if (Evaluate(low) != DuelSocialDecision.DeclineLowHealth)
+                return "FAIL low-health willingness";
+
+            DuelWillingnessInput recent = new DuelWillingnessInput
+            {
+                RecentDuel = true,
+                Rival = true,
+                StableKey = "recent"
+            };
+            if (Evaluate(recent) != DuelSocialDecision.DeclineRecentDuel)
+                return "FAIL recent-duel cooldown";
+
+            // This state declines without Rival but accepts with Rival. Rival changes willingness;
+            // it is not a hard override because the low-health/cooldown checks run first.
+            DuelWillingnessInput rival = new DuelWillingnessInput
+            {
+                HasHealth = true,
+                CurrentHealth = 55,
+                MaximumHealth = 100,
+                HasLevel = true,
+                PlayerLevel = 20,
+                SimLevel = 27,
+                StableKey = "rival-a"
+            };
+            DuelSocialDecision withoutRival = Evaluate(rival);
+            rival.Rival = true;
+            DuelSocialDecision withRival = Evaluate(rival);
+            if (withoutRival == DuelSocialDecision.Accept || withRival != DuelSocialDecision.Accept)
+                return "FAIL Rival bounded modifier";
+
+            DuelWillingnessInput deterministic = new DuelWillingnessInput
+            {
+                HasHealth = true,
+                CurrentHealth = 80,
+                MaximumHealth = 100,
+                HasLevel = true,
+                PlayerLevel = 15,
+                SimLevel = 17,
+                StableKey = "same-state"
+            };
+            DuelSocialDecision first = Evaluate(deterministic);
+            for (int i = 0; i < 8; i++)
+                if (Evaluate(deterministic) != first) return "FAIL deterministic decision";
+
+            return "PASS deterministic willingness policy";
+        }
+
+        private static int StableOffset(string value)
+        {
+            unchecked
+            {
+                uint hash = 2166136261u;
+                string text = value ?? string.Empty;
+                for (int i = 0; i < text.Length; i++)
+                {
+                    hash ^= char.ToLowerInvariant(text[i]);
+                    hash *= 16777619u;
+                }
+                return (int)(hash % 3u) - 1;
+            }
+        }
+    }
+}
